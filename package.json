{
  "name": "dsh-snapcompact",
  "version": "0.7.1",
  "description": "DeepSeek Harness plugin that compacts long chats by rendering history into compact bitmap frames a vision model can read, with exact head/tail text and a bounded exact-token index.",
  "type": "module",
  "license": "MIT",
  "author": "Cyberbolt",
  "icon": "icon.svg",
  "homepage": "https://github.com/Cyberbolt/dsh-snapcompact#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cyberbolt/dsh-snapcompact.git"
  },
  "bugs": {
    "url": "https://github.com/Cyberbolt/dsh-snapcompact/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "compaction",
    "context-compaction",
    "plugin"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "engines": {
    "node": ">=24",
    "dsh": "^0.2.2-rc.1"
  },
  "packageManager": "pnpm@11.28.5",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./settings": {
      "types": "./dist/settings-entry.d.ts",
      "default": "./dist/settings-entry.js"
    },
    "./client": "./client/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "client",
    "assets",
    "locale",
    "presets",
    "cordis.patch.yml",
    "icon.svg",
    "docs",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "THIRD_PARTY_NOTICES.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node --experimental-strip-types scripts/build-preset.ts && node --experimental-strip-types scripts/build-client.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-strip-types scripts/check.ts --test-only",
    "test:watch": "vitest",
    "check:package": "node --experimental-strip-types scripts/check-package.ts",
    "check:install": "node --experimental-strip-types scripts/check-install.ts",
    "check": "node --experimental-strip-types scripts/check.ts",
    "release:plan": "node --experimental-strip-types scripts/release.ts",
    "release:verify": "node --experimental-strip-types scripts/verify-release.ts",
    "prepublishOnly": "pnpm run check"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-attachment": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-commands": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-compaction": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-compaction-basic": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-session-projection": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-token-meter": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-attachment": "0.2.2-rc.1",
    "@deepseek-ai/dsh-commands": "0.2.2-rc.1",
    "@deepseek-ai/dsh-compaction": "0.2.2-rc.1",
    "@deepseek-ai/dsh-compaction-basic": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-token-meter": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@eslint/js": "9.39.1",
    "@types/node": "24.10.0",
    "@types/pngjs": "6.0.5",
    "eslint": "9.39.1",
    "pngjs": "7.0.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vitest": "4.0.8",
    "yaml": "2.8.1"
  }
}
